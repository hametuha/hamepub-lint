{
    "name": "hametuha/publint",
    "description": "ePub lint API by hametuha.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Hametuah INC",
            "email": "info@hametuha.co.jp"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-simplexml": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/php-view": "^3.4"
    },
    "require-dev": {
        "ext-zip": "*",
        "phpunit/phpunit": "^12.4"
    },
    "config": {
        "process-timeout" : 0,
        "sort-packages": true
    },
    "autoload": {
        "psr-0": {
            "Hametuha\\PubLint": "app"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/index.php",
        "test": "phpunit"
    }
}
