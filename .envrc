# このリポジトリに入ったときだけ gcloud / aws を PubLint 用に固定する。
#
# 目的は **tarosky と hametuha の混同防止**。gcloud のグローバル設定に依存すると、
# 別リポジトリで `gcloud config set project` した状態が漏れてくる。
# ここで環境変数を撒いておけば、グローバル設定より環境変数が優先される。
#
# 使い方:
#   direnv allow          # 初回のみ（このファイルを信頼する）
#   gcloud config list    # project が下の値になっていることを確認
#
# シークレットは書かない。個人的な上書きは .envrc.local（gitignore済み）に置く。

# ---- GCP（PubLint 専用プロジェクト。課金を独立させる）
export CLOUDSDK_CORE_PROJECT=hamepub
export GOOGLE_CLOUD_PROJECT=hamepub
export CLOUDSDK_CORE_ACCOUNT=takahashi.fumiki@hametuha.co.jp
export CLOUDSDK_COMPUTE_REGION=asia-northeast1
export CLOUDSDK_RUN_REGION=asia-northeast1

# ---- AWS（Route53 の hametuha.pub ゾーン、旧 EC2 の後片付け用。hametuha-infra と同じ）
export AWS_PROFILE=default

source_env_if_exists .envrc.local

# ---- 現在の固定先を表示して、取り違えに気づけるようにする
echo "[hamepub-lint] GCP=${CLOUDSDK_CORE_PROJECT} / account=${CLOUDSDK_CORE_ACCOUNT} / AWS=${AWS_PROFILE}"
